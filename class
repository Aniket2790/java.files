 import java.util.*;
 
 class pen{
     String color;
     String type;
     
     public void printColor(){
         System.out.println(this.color);
     }
     
     public void printType(){
          System.out.println(this.type);
     }
 }
 public class Main{
     public static void main(String[] k){
         pen pen1 = new pen();
         pen1.color =" blue";
         pen1.type =" ballpoint";
         
         pen pen2 = new pen();
         pen2.color ="black";
         pen2.type="gel";
         
         pen1.printColor();
          
         
         pen1.printType();
         pen2.printColor();
         pen2.printType();
     }
 }
